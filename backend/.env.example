DATABASE_URL=postgresql+psycopg://postgres:your-database-password@localhost:5432/mypass
SECRET_KEY=replace-with-a-long-random-secret

# Gmail SMTP: enable 2-Step Verification and create a Google App Password.
# The app password has 16 characters; spaces are optional.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-sender@gmail.com
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# Must be reachable from the recipient's browser.
FRONTEND_LOGIN_URL=http://localhost:5173/login
FRONTEND_RESET_URL=http://localhost:5173/reset-password
